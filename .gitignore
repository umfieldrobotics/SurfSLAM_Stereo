.pytest_cache/
.vscode/

outputs/
*/__pycache__/
**/output/

# Run outputs. Anchored to the repo root on purpose: a bare `eval/` would also
# match config/eval/, which is tracked.
/eval/
/runs/
/debug/

# Dataset index caches (utils/index_cache.py); regenerated by scanning.
/cache/
wandb/
.gradio/
.claude/

# Machine-specific settings, copied from the .example.yaml next to each of them:
# dataset locations (docs/data.md) and the wandb account runs are logged to.
config/dataset_paths.yaml
config/wandb.yaml

# Site-local model/eval configs that never ship.
config/train/models/*_internal/
config/train/models_internal/
config/eval/models/*_internal/

# Texture libraries ship as the tracked .tar.xz next to each of these directories
# and are extracted on first use (see ensure_texture_lib in uw_augmentations.py).
data/particles_texture_lib/
data/water_augmentations/caustic_textures/


.submodule-archive-*/
sandbox/