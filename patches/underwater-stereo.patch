# Underwater_Stereo (BGNet): make the eval baseline runnable as a subpackage.
#
# base: 9972b9cc9598b4d720384372dc4a6855290c28a9
# upstream: https://github.com/Jinyi-Z/Underwater_Stereo
#
# Only BGNet is used here, and only for evaluation -- see evaluate.py:forward_eval.
# There is no training path for it in this project.
#
# Two of these changes originate with Yung-Ching Sun (ycsun), who first got BGNet
# running on this data; the rest are ours. Both groups are necessary:
#
#   Nets/bgnet.py                  ycsun -- upstream calls .convert('L'), a PIL
#                                  method, on a torch tensor. BGNet cannot run on
#                                  tensor input without this.
#   Nets/feature_extractor_fast.py ycsun -- resample the skip connection instead of
#                                  tripping the shape assert on odd input sizes.
#   Nets/bgnet.py                  ours -- drop the unused Utils.warp import, which
#   Nets/bgnet_plus.py                     is unresolvable once Nets is a subpackage.
#   Nets/submodules2d.py           ours -- relative import (..Utils.warp) so Nets
#   Utils/metrics.py                       and Utils resolve as subpackages of
#                                          models.Underwater_Stereo instead of
#                                          needing the repo root on sys.path.
diff --git a/Nets/bgnet.py b/Nets/bgnet.py
index 7b0f0ed..529114e 100644
--- a/Nets/bgnet.py
+++ b/Nets/bgnet.py
@@ -8,10 +8,10 @@ from .feature_extractor_fast import feature_extraction
 from .submodules3d import CoeffsPredictor
 from .submodules2d import HourglassRefinement
 from .submodules import SubModule,convbn_2d_lrelu,convbn_3d_lrelu,convbn_2d_Tanh
-from Utils.warp import disp_warp
 import torch
 import torch.nn as nn
 import torch.nn.functional as F
+import torchvision.transforms as transforms
 import time        
 class Slice(SubModule):
     def __init__(self):
@@ -81,8 +81,10 @@ class BGNet(SubModule):
         self.weight_init()
 
     def forward(self, left_input, right_input):
-        left_input = left_input.convert('L')
-        right_input = right_input.convert('L')
+        # .convert('L') is a PIL method; these are tensors.
+        grayscale = transforms.Grayscale(num_output_channels=1)
+        left_input = grayscale(left_input)
+        right_input = grayscale(right_input)
         left_low_level_features_1,  left_gwc_feature  = self.feature_extraction(left_input)
         _,                          right_gwc_feature = self.feature_extraction(right_input)
         
