index 8230a83..84fbde6 100644
--- a/Nets/feature_extractor_fast.py
+++ b/Nets/feature_extractor_fast.py
@@ -8,6 +8,7 @@ import torch
 import torch.nn as nn
 import torch.utils.data
 import torch.nn.functional as F
+import logging
 def convbn_relu(in_planes, out_planes, kernel_size, stride, pad, dilation):
 
     return nn.Sequential(nn.Conv2d(in_planes, out_planes, kernel_size=kernel_size, stride=stride,
@@ -92,6 +93,9 @@ class Conv2x(nn.Module):
     def forward(self, x, rem):
 
         x = self.conv1(x)
+        if x.shape != rem.shape:
+            logging.debug("Conv2x: resizing skip from %s to %s", tuple(rem.shape), tuple(x.shape))
+            rem = F.interpolate(rem, size=x.shape[2:], mode='bilinear', align_corners=False)
         assert(x.size() == rem.size())
         if self.concat:
             x = torch.cat((x, rem), 1)
